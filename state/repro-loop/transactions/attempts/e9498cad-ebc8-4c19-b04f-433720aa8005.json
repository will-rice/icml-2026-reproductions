        "live_claims": [
          {
            "status": "unverified",
            "text": "EEG-FM-Bench curates 14 public datasets spanning 10 canonical EEG paradigms with standardized preprocessing and evaluation (Figure 1)."
          },
          {
            "status": "unverified",
            "text": "The benchmark evaluates frozen-backbone single-task fine-tuning, full-parameter single-task fine-tuning, and full-parameter multi-task fine-tuning strategies (Figure 1)."
          },
          {
            "status": "unverified",
            "text": "Frozen-backbone evaluation exposes a generalization gap, with many EEG foundation models performing only slightly above chance on several tasks (Table 1)."
          },
          {
            "status": "unverified",
            "text": "Separate full-parameter fine-tuning substantially improves performance over frozen-backbone probing across the seven main BCI tasks (Table 2)."
          },
          {
            "status": "unverified",
            "text": "Qualitative t-SNE and Integrated Gradients analyses show stronger models forming clearer task clusters and focusing on neurophysiologically relevant channels (Figure 2)."
          }
        ],
