        "live_claims": [
          {
            "status": "unverified",
            "text": "The paper casts dataset pruning as a graph problem with node weights for intrinsic importance and edge weights for extrinsic diversity/interaction, yielding a Maximum Weight Clique formulation (Section 3.3)."
          },
          {
            "status": "unverified",
            "text": "Under mild conditions, the unified objective becomes submodular and admits a greedy approximation guarantee (Section 3.6; Appendix F)."
          },
          {
            "status": "unverified",
            "text": "UGIES outperforms state-of-the-art dataset pruning methods on CIFAR-10/100 with ResNet-18 (Table 1)."
          },
          {
            "status": "unverified",
            "text": "On ImageNet-1K, UGIES achieves lossless or better-than-lossless pruning with ResNet-50 and Swin-T at moderate pruning ratios (Table 2)."
          },
          {
            "status": "unverified",
            "text": "With ResNet-50 on ImageNet-1K at a 50% pruning ratio, UGIES reaches the same accuracy while saving 43.2% total training cost (Table 3)."
          },
          {
            "status": "unverified",
            "text": "Ablations show combining intrinsic and extrinsic importance terms outperforms using either component alone across pruning ratios (Table 4)."
          }
        ],
