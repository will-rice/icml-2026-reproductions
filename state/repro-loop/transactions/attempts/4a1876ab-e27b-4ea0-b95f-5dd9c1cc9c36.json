        "live_claims": [
          {
            "status": "unverified",
            "text": "AGoQ combines layer-aware activation quantization and precision-preserved gradient quantization within Megatron-LM-style distributed training (Section 3)."
          },
          {
            "status": "unverified",
            "text": "Layer-aware activation quantization reduces cached activation memory for a transformer layer from 28U in BF16 and 16.5U in COAT to 7.75U (Table 1)."
          },
          {
            "status": "unverified",
            "text": "Dynamic Bit-width Compensation for Pipeline Parallelism assigns higher activation bit-widths to underutilized pipeline stages while maintaining near-4-bit activation storage (Section 4.2)."
          },
          {
            "status": "unverified",
            "text": "Kernel fusion combines quantization/dequantization with adjacent GEMM operations to reduce activation-quantization overhead (Figure 4)."
          },
          {
            "status": "unverified",
            "text": "On LLaMA2-13B sequence lengths from 32K to 80K, AGoQ reports faster training than Megatron-LM and ZeRO-1 while avoiding activation recomputation in the listed settings (Table 2)."
          },
          {
            "status": "unverified",
            "text": "AGoQ reports lower memory than COAT and comparable or faster training time on OLMo-1B at 24K and 32K sequence lengths (Table 3)."
          }
        ],
