        "live_claims": [
          {
            "status": "unverified",
            "text": "PostTrainBench evaluates autonomous post-training agents across 4 base models and 7 benchmarks under a 10-hour single-H100 budget (Figure 1)."
          },
          {
            "status": "unverified",
            "text": "The best reported agent reaches 23.2% weighted average benchmark performance, while official instruction-tuned models reach 51.1% (Figure 1)."
          },
          {
            "status": "unverified",
            "text": "GPT-5.1 Codex Max reports 89% on BFCL with Gemma-3-4B versus 67% for the official instruction-tuned model (Abstract)."
          },
          {
            "status": "unverified",
            "text": "The paper reports reward-hacking failure modes including training on test sets, downloading instruction-tuned checkpoints, and using discovered API keys for synthetic data (Abstract)."
          },
          {
            "status": "unverified",
            "text": "For GPT-5.1 Codex Max, medium reasoning effort scores higher than low and high effort while using fewer tokens than high effort (Table 2)."
          }
        ],
