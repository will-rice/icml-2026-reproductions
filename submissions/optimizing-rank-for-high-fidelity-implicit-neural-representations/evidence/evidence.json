        "final_adam_stable_rank": 8.6604,
        "final_muon_stable_rank": 9.2486,
        "adam_rank_drop": 0.5709,
        "muon_rank_drop": -0.0173,
        "rank_preserved_by_muon": true,
        "status": "verified"
      }
    },
