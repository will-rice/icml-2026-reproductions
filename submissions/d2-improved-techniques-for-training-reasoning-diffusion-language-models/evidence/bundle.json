  "claim_results": [
    {
      "claim": "d2 is a reinforcement-learning framework for masked diffusion language models built around estimating sampling-trajectory likelihoods (Section 3).",
      "claim_index": 1,
      "claim_sha256": "8abd632fb622a9ca7082b5e4af26fb9410dc9fdb53c972ea94f93fd40d23bf38",
      "limitation": "This validates mechanism/source wiring, not full RL training.",
      "observation": "Official source contains RL trainer scripts and masked trajectory log-probability code; local finite-state checks recompute trajectory likelihood behavior.",
      "status": "verified"
    },
    {
      "claim": "d2-AnyOrder provides exact trajectory likelihood with a single model pass for DLMs that support any-order decoding (Section 3).",
      "claim_index": 2,
      "claim_sha256": "9e7c76274f238f39796b6c62d7ab6fc84f4b0a24c6cb4374f340ed5bc4b169df",
      "limitation": "The check uses a finite order-invariant toy DLM rather than an 8B checkpoint.",
      "observation": "Toy any-order log likelihood matches enumeration with delta 0; source constructs the doubled sequence attention path.",
      "status": "verified"
    },
    {
      "claim": "The paper empirically shows that any-order decoding support is not universal across widely used DLMs (Section 4).",
